# Either paste the key directly ...
OPENROUTER_API_KEY=

# ... or point at a 1Password secret reference and leave the key blank.
# Find yours with:  op item get "OpenRouter" --format json | jq '.fields[].label'
SISM_OP_SECRET_REF=op://Private/OpenRouter/credential

# Optional OpenRouter attribution headers
OPENROUTER_APP_URL=https://github.com/sameermankotia/sism-eval
OPENROUTER_APP_TITLE=SISM-Eval
